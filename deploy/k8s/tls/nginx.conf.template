server {
  listen 8080 ssl;
  ssl_certificate /etc/companion-tls/tls.crt;
  ssl_certificate_key /etc/companion-tls/tls.key;
  ssl_protocols TLSv1.2 TLSv1.3;
  root /usr/share/nginx/html;
  index index.html;

  proxy_ssl_verify on;
  proxy_ssl_trusted_certificate /etc/companion-tls/ca.crt;
  proxy_ssl_verify_depth 2;
  proxy_ssl_server_name on;
  proxy_connect_timeout 5s;
  proxy_read_timeout 15s;

  # Server-Sent Events (live demo feed): never buffer, keep the stream open.
  location = /api/events {
    proxy_pass ${API_UPSTREAM};
    proxy_http_version 1.1;
    proxy_set_header Connection "";
    proxy_ssl_name api;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto https;
    proxy_buffering off;
    proxy_cache off;
    proxy_read_timeout 1h;
  }
  location /api/ {
    proxy_pass ${API_UPSTREAM};
    proxy_ssl_name api;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto https;
  }
  location = /healthz {
    proxy_pass ${API_UPSTREAM};
    proxy_ssl_name api;
  }
  # The product front door is the static site under /site/.
  location = / {
    return 302 /site/;
  }
  location = /site {
    return 302 /site/;
  }
  # The static pages resolve their endpoints relative to the module (../api/x from /site/js/ is /site/api/x):
  # map them onto the real API's /api/x.
  location = /site/api/events {
    proxy_pass ${API_UPSTREAM}/api/events;
    proxy_http_version 1.1;
    proxy_set_header Connection "";
    proxy_ssl_name api;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto https;
    proxy_buffering off;
    proxy_cache off;
    proxy_read_timeout 1h;
  }
  location /site/api/ {
    proxy_pass ${API_UPSTREAM}/api/;
    proxy_ssl_name api;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto https;
  }
  # Signed Apple Wallet passes: Wallet and the app only accept this content type.
  location ~ ^/site/passes/.+\.pkpass$ {
    types { }
    default_type application/vnd.apple.pkpass;
  }
  location /site/ {
    try_files $uri $uri/ /site/index.html;
  }
  # SPA fallback for client-side routes (/schedule, /search, ...)
  location / {
    try_files $uri /index.html;
  }
}
