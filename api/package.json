{
  "name": "@cc/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsx watch --import ./src/telemetry/instrument.ts src/index.ts",
    "start": "node --import ./dist/telemetry/instrument.js dist/index.js",
    "test": "vitest run",
    "seed": "tsx src/db/seed.ts",
    "retention": "node dist/retention-cli.js",
    "clusters": "tsx src/clusters/cli.ts",
    "clusters:seed": "tsx src/clusters/seed.ts",
    "db:init": "tsx src/db/init.ts"
  },
  "dependencies": {
    "@cc/shared": "*",
    "@fastify/otel": "^1.0.1",
    "@fastify/rate-limit": "^11.2.2",
    "@huggingface/transformers": "^4.3.2",
    "@opentelemetry/api": "^1.10.0",
    "@opentelemetry/context-async-hooks": "^3.1.1",
    "@opentelemetry/exporter-logs-otlp-http": "^0.301.1",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.301.1",
    "@opentelemetry/exporter-trace-otlp-http": "^0.301.1",
    "@opentelemetry/instrumentation-http": "^0.301.1",
    "@opentelemetry/instrumentation-pino": "^0.71.0",
    "@opentelemetry/instrumentation-undici": "^0.35.0",
    "@opentelemetry/resources": "^3.1.1",
    "@opentelemetry/sdk-logs": "^3.1.1",
    "@opentelemetry/sdk-metrics": "^3.1.1",
    "@opentelemetry/sdk-node": "^0.301.1",
    "@opentelemetry/sdk-trace": "^3.1.1",
    "fastify": "^5.1.0",
    "jose": "^6.2.17",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.15",
    "@electric-sql/pglite-pgvector": "^0.0.17",
    "@types/node": "^20.17.0",
    "@types/pg": "^8.23.1",
    "ical.js": "2.2.1",
    "tsx": "^4.19.0",
    "typescript": "^5.6.3",
    "vite": "^8.3.8",
    "vitest": "^4.1.12"
  }
}
