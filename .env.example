# API configuration (copy to .env for local dev; never commit real secrets)
PORT=3000
ES_URL=http://localhost:9200
ES_USERNAME=
ES_PASSWORD=
TOKEN_SIGNING_KEY=change-me
OTEL_EXPORTER_OTLP_ENDPOINT=

# Talk vectors: talks.content_semantic is a semantic_text field, so Elasticsearch embeds
# title + abstract itself at index time (needs ML node + trial/Platinum license).
# Inference endpoint behind it (default .multilingual-e5-small-elasticsearch; ELSER: .elser-2-elasticsearch)
# ES_INFERENCE_ID=.multilingual-e5-small-elasticsearch
# embed() for client-side vectors (attendee interests): "es-inference" (default) or "local"
# (offline hashed bag-of-words, used by unit tests).
EMBEDDINGS_PROVIDER=es-inference
EMBEDDING_DIMS=384
# Optional: override the seed file (default data/talks.json)
# TALKS_FILE=
