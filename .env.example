# API configuration (copy to .env for local dev; never commit real secrets)
PORT=3000
ES_URL=http://localhost:9200
ES_USERNAME=
ES_PASSWORD=
TOKEN_SIGNING_KEY=change-me
OTEL_EXPORTER_OTLP_ENDPOINT=

# Embeddings: "local" = deterministic hashed bag-of-words (no network, no key).
EMBEDDINGS_PROVIDER=local
EMBEDDING_DIMS=256
# Optional: override the seed file (default data/talks.json)
# TALKS_FILE=
