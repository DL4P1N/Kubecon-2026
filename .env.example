# API configuration (copy to .env for local dev; never commit real secrets)
PORT=3000
# Postgres with pgvector: local compose (deploy/compose) or Supabase's session pooler (IPv4).
DATABASE_URL=postgresql://postgres:postgres@localhost:54322/postgres
# Supabase signs its server certificate with its own root CA; point at it (verification stays on).
# DATABASE_CA_FILE=deploy/k8s/overlays/toghouse/supabase-ca.crt
# HS256 key for attendee tokens, from a K8s Secret. With NODE_ENV=production the API
# refuses to start if it is missing, a placeholder like change-me, or under 32 chars.
TOKEN_SIGNING_KEY=change-me
# HMAC key (>=32 random chars) for the OAuth account -> attendee link. Required when a complete OAuth provider is configured.
IDENTITY_HASH_KEY=
# Max POST /api/register per client IP per minute (default 60).
REGISTER_RATE_LIMIT_PER_MINUTE=60
OTEL_EXPORTER_OTLP_ENDPOINT=

# Search and profile vectors: "e5" (default) runs multilingual-e5-small inside the API (about 120 MB model,
# downloaded on first use when MODEL_ALLOW_DOWNLOAD=true, otherwise read from MODEL_CACHE_DIR);
# "local" is an offline hashed bag-of-words (tests, no model, lexical quality only).
EMBEDDINGS_PROVIDER=e5
# MODEL_CACHE_DIR=./models
# MODEL_ALLOW_DOWNLOAD=true
# Optional: override the seed file (default data/talks.json)
# TALKS_FILE=
# Trusted proxy hops: 0 for direct/local access, 1 for web nginx -> API.
TRUST_PROXY=0

# Cluster map (Module 4). The GET /api/interests/clusters route requires this value in the
# x-organizer-key header; in production the route refuses requests while it is unset.
# Set it from the same Kubernetes Secret as TOKEN_SIGNING_KEY. Never commit a real value.
ORGANIZER_KEY=

# Registration chat (POST /api/chat). "auto" (default) answers with the Claude Code CLI when a `claude`
# binary is on PATH (or at CLAUDE_BIN), otherwise with the built-in scripted flow. "scripted" never
# spawns the CLI. The cluster's API image has no CLI, so scripted is expected there. In claude mode every
# chat turn spends Claude usage; the per-IP limit on /api/chat is the only guard.
CHAT_MODE=auto
# CLAUDE_BIN=/usr/local/bin/claude
# ROOM_CAPACITIES={"Hall A": 400, "Room 2": 80}   <- GET /api/rooms/placement: JSON room name to seats; unlisted rooms have unknown capacity
# ATTENDEE_RETENTION_HOURS=24   <- attendee profiles are kept by default (0 or unset); set a whole number of hours to delete them after that long
# EVENTS_SHOW_NAMES=on   # demo only: GET /api/events (unauthenticated) then carries each registrant's first name instead of "Guest"
